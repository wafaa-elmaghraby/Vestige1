# Canonical production URL used for sitemap generation and OpenGraph URLs
VITE_SITE_URL=https://vestige-atlas.com

# Base path when deploying to a subpath (e.g. /vestige/ on GitHub Pages)
VITE_BASE=/

# Optional metadata overrides
VITE_APP_TITLE="VESTIGE — Interplanetary Relic Atlas"
VITE_APP_DESCRIPTION="A bilingual scientific atlas of the spacecraft humanity left on the Moon and Mars."
VITE_APP_LOGO_URL=/favicon.svg

# Optional Twitter/X attribution handles
VITE_TWITTER_SITE=@vestigeatlas
VITE_TWITTER_CREATOR=@vestigeatlas

# Local dev server configuration
VITE_PORT=3000
BACKEND_PORT=8000

# Optional backend runtime config endpoint (set to "true" only if hosting /api/config)
VITE_RUNTIME_CONFIG_ENABLED=false
VITE_API_BASE_URL=
